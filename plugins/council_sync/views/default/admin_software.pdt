<div class="main-content-padding">
<?php
echo ($message ?? '');
require __DIR__ . DIRECTORY_SEPARATOR . 'software_banner.pdt';
$this->Widget->clear();
$this->Widget->setLinks([
    ['name' => $this->_('AdminMain.settings', true), 'attributes' => ['href' => $sync_uri]],
    ['name' => $this->_('AdminSoftware.title', true), 'current' => true, 'attributes' => ['href' => $software_uri]]
]);
$this->Widget->create($this->_('AdminSoftware.title', true), ['id' => 'council-sync-software']);
?>
        <p class="alert alert-warning"><?php $this->_('AdminSoftware.global_warning'); ?></p>
        <?php if (!$install_supported) { ?>
            <p class="alert alert-warning"><?php $this->_('AdminSoftware.platform_requirement'); ?></p>
        <?php } ?>
        <p><?php $this->_('AdminSoftware.versions'); ?>
            <?php echo $this->Html->safe($version_status['installed'] . ' / ' . $version_status['package']
                . ' / ' . ($version_status['latest'] ?? $this->_('AdminMain.unknown', true))); ?>
        </p>
        <p><?php $this->_('AdminMain.version_' . $version_status['status']); ?></p>
        <?php if ($version_status['error_code'] !== null) { ?>
            <p class="text-warning"><?php echo $this->Html->safe($version_status['error_code']); ?>
                <?php $this->_('AdminMain.version_private_help'); ?>
            </p>
        <?php } ?>
        <?php if ($version_status['upgrade_required']) { ?>
            <p class="text-warning"><?php $this->_('AdminMain.version_upgrade_required'); ?></p>
        <?php } ?>
        <?php if (!$software_trial) { ?>
            <?php $this->Form->create($software_uri . 'checkupdates/'); ?>
            <button type="submit" class="btn btn-outline-secondary my-3"><?php $this->_('AdminMain.check_updates'); ?></button>
            <?php $this->Form->end(); ?>
            <?php $this->Form->create($software_uri); ?>
            <div class="mb-3">
                <label class="form-label" for="software-backup-dir"><?php $this->_('AdminSoftware.backup_dir'); ?></label>
                <?php $this->Form->fieldText('backup_dir', $configuration['backup_dir'], ['id' => 'software-backup-dir', 'class' => 'form-control', 'required' => 'required']); ?>
                <p class="form-text"><?php $this->_('AdminSoftware.backup_help'); ?></p>
                <label class="form-check">
                    <?php $this->Form->fieldCheckbox('confirm_private', '1', false, ['class' => 'form-check-input', 'required' => 'required']); ?>
                    <span><?php $this->_('AdminSoftware.private_confirm'); ?></span>
                </label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="software-window"><?php $this->_('AdminSoftware.window'); ?></label>
                <?php $this->Form->fieldNumber('window_hours', $configuration['window_hours'], 1, 4294967295, 1, ['id' => 'software-window', 'class' => 'form-control', 'required' => 'required']); ?>
                <p class="text-danger"><?php $this->_('AdminSoftware.window_warning'); ?></p>
            </div>
            <button type="submit" class="btn btn-primary"><?php $this->_('AdminMain.save'); ?></button>
            <?php $this->Form->end(); ?>
            <?php if ($install_supported && $configuration['backup_dir'] && $version_status['status'] === 'outdated' && !$version_status['upgrade_required']) { ?>
                <hr>
                <?php $this->Form->create($software_uri . 'install/'); ?>
                <?php $this->Form->fieldHidden('version', $version_status['latest']); ?>
                <p><?php echo $this->Html->safe($version_status['package'] . ' -> ' . $version_status['latest']); ?></p>
                <label class="form-check">
                    <?php $this->Form->fieldCheckbox('confirm_install', '1', false, ['class' => 'form-check-input', 'required' => 'required']); ?>
                    <span><?php $this->_('AdminSoftware.install_confirm'); ?></span>
                </label>
                <button type="submit" class="btn btn-danger mt-2"><?php $this->_('AdminSoftware.install'); ?></button>
                <?php $this->Form->end(); ?>
            <?php } else { ?>
                <p class="mt-3"><?php $this->_('AdminSoftware.install_unavailable'); ?></p>
            <?php } ?>
        <?php } ?>
<?php $this->Widget->end(); ?>
</div>
